# ============================================================================
# GestLab SaaS — Segreti (NON committare questo file con valori reali!)
# ============================================================================
# Copiare questo file in `.env` e inserire i valori effettivi.
# In produzione usare un Secret Manager (AWS/GCP/Azure) o env del container.
# ============================================================================

# --- Database (MySQL) ---
# In cloud: indirizzo del DB gestito (RDS/Cloud SQL), non localhost.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=data
DB_USER=root
DB_PWD=

# --- Autenticazione JWT ---
# Segreto per firmare i token. In produzione: stringa lunga e casuale.
JWT_SECRET=change_me_in_production_please

# --- Token Facebook (integrazione) ---
# Il token scade: gestirlo server-side con refresh automatico.
# FB_TOKEN=

# --- Local Print Agent ---
# Token del dispositivo di stampa (generato via POST /api/v1/dispositivi).
# GESTLAB_AGENT_TOKEN=

# --- URL del backend (per il Local Print Agent) ---
# GESTLAB_API_URL=http://localhost:8000

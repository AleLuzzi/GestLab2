#:kivy 2.3.1
#:import FitImage kivymd.uix.fitimage.FitImage
#:include desktop/lotti_vendita/lotti_vendita.kv
#:include desktop/chiudi_lotto/chiudi_lotto.kv
#:include desktop/nuovo_menu/nuovo_menu.kv
#:include desktop/ingresso_merce/ingresso_merce.kv
#:include desktop/lotti_vendita/lotti_vendita.kv
#:include desktop/chiudi_lotto/chiudi_lotto.kv
#:include desktop/nuovo_menu/nuovo_menu.kv
#:include desktop/ingresso_merce/ingresso_merce.kv
#:include desktop/anag_dipendenti/anag_dipendenti.kv
#:include desktop/anag_reparti/anag_reparti.kv

# Pulsante standard del menu principale (stile "filled" condiviso).
<MenuButton@MDButton>:
    style: "filled"

<Menu>:
    MDBoxLayout:
        orientation: 'vertical'
        md_bg_color: app.theme_cls.backgroundColor
        MDTopAppBar:
            type: "small"
            theme_bg_color: "Custom"
            md_bg_color: app.theme_cls.primaryColor
            MDTopAppBarTitle:
                text: 'Gestione Laboratorio'
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
        MDGridLayout:
            cols: 2
            padding: dp(24)
            spacing: dp(16)
            size_hint_y: 0.7
            MenuButton:
                on_release: root.ingresso_merce()
                MDButtonIcon:
                    icon: 'truck-delivery-outline'
                MDButtonText:
                    text: 'Ingresso Merce'
            MenuButton:
                on_release: root.nuovo_lotto()
                MDButtonIcon:
                    icon: 'plus-box-outline'
                MDButtonText:
                    text: 'Nuovo Lotto'
            MenuButton:
                on_release: root.chiudi_lotto()
                MDButtonIcon:
                    icon: 'archive-arrow-down-outline'
                MDButtonText:
                    text: 'Chiudi Lotti'
            MenuButton:
                on_release: root.lotti_vendita()
                MDButtonIcon:
                    icon: 'point-of-sale'
                MDButtonText:
                    text: 'Vendita'
            MenuButton:
                # TODO: implementare la schermata Impostazioni.
                # attualmente il pulsante non esegue alcuna azione.
                MDButtonIcon:
                    icon: 'cog-outline'
                MDButtonText:
                    text: 'Impostazioni'
            MenuButton:
                on_release: root.anag_dipendenti()
                MDButtonIcon:
                    icon: 'account-group-outline'
                MDButtonText:
                    text: 'Dipendenti'
            MenuButton:
                on_release: root.anag_reparti()
                MDButtonIcon:
                    icon: 'warehouse'
                MDButtonText:
                    text: 'Reparti'
            MenuButton:
                on_release: root.nuovo_menu()
                MDButtonIcon:
                    icon: 'silverware-fork-knife'
                MDButtonText:
                    text: 'Nuovo Menu'
            MenuButton:
                on_release: root.esci()
                MDButtonIcon:
                    icon: 'exit-to-app'
                MDButtonText:
                    text: 'Esci'
        MDBoxLayout:
            size_hint_y: 0.3
            FitImage:
                source: 'immagini/dlogo.png'
                fit_mode: 'contain'
                size_hint_y: None
                height: dp(140)
                pos_hint: {'center_x': 0.5, 'center_y': 0.5}


#:kivy 2.3.1
#:import FitImage kivymd.uix.fitimage.FitImage
#:include lotti_vendita/lotti_vendita.kv
#:include chiudi_lotto/chiudi_lotto.kv
#:include nuovo_menu/nuovo_menu.kv
#:include ingresso_merce/ingresso_merce.kv
#:include anag_dipendenti/anag_dipendenti.kv

<menu>:
    MDBoxLayout:
        orientation: 'vertical'
        md_bg_color: app.theme_cls.backgroundColor
        MDTopAppBar:
            type: "small"
            theme_bg_color: "Custom"
            md_bg_color: app.theme_cls.primaryColor
            MDTopAppBarTitle:
                text: 'Gestione Laboratorio'
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
        MDGridLayout:
            cols: 2
            padding: dp(24)
            spacing: dp(16)
            size_hint_y: 0.8
            MDButton:
                style: "filled"
                on_release: root.ingresso_merce()
                MDButtonIcon:
                    icon: 'truck-delivery-outline'
                MDButtonText:
                    text: 'Ingresso Merce'
            MDButton:
                style: "filled"
                on_release: root.nuovo_lotto()
                MDButtonIcon:
                    icon: 'plus-box-outline'
                MDButtonText:
                    text: 'Nuovo Lotto'
            MDButton:
                style: "filled"
                on_release: root.chiudi_lotto()
                MDButtonIcon:
                    icon: 'archive-arrow-down-outline'
                MDButtonText:
                    text: 'Chiudi Lotti'
            MDButton:
                style: "filled"
                on_release: root.lotti_vendita()
                MDButtonIcon:
                    icon: 'point-of-sale'
                MDButtonText:
                    text: 'Vendita'
            MDButton:
                style: "filled"
                MDButtonIcon:
                    icon: 'cog-outline'
                MDButtonText:
                    text: 'Impostazioni'
            MDButton:
                style: "filled"
                on_release: root.anag_dipendenti()
                MDButtonIcon:
                    icon: 'account-group-outline'
                MDButtonText:
                    text: 'Dipendenti'
            MDButton:
                style: "filled"
                on_release: root.nuovo_menu()
                MDButtonIcon:
                    icon: 'silverware-fork-knife'
                MDButtonText:
                    text: 'Nuovo Menu'
            MDButton:
                style: "filled"
                on_release: root.esci()
                MDButtonIcon:
                    icon: 'exit-to-app'
                MDButtonText:
                    text: 'Esci'
        MDBoxLayout:
            size_hint_y: 0.2
            FitImage:
                source: './/immagini//dlogo.png'
                size_hint: None, None
                size: dp(180), dp(140)
                pos_hint: {'center_x': 0.5, 'center_y': 0.5}


# Copiare in deploy/gestlab.env e compilare i valori.
# Non committare deploy/gestlab.env.

GESTLAB_ENV=production

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gestlab
DB_USER=gestlab_app
DB_PWD=
DB_POOL_SIZE=10
# Obbligatorio per MySQL/RDS remoto in produzione: percorso al bundle CA PEM.
# Esempio: /etc/ssl/certs/global-bundle.pem
DB_SSL_CA=

JWT_SECRET=

GESTLAB_ADMIN_EMAIL=
GESTLAB_ADMIN_PASSWORD=
GESTLAB_TENANT_NOME=Laboratorio Test AWS

# Reset password. Senza SMTP_HOST e SMTP_FROM la richiesta risponde 503.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
GESTLAB_PUBLIC_URL=https://esempio.gestlab.it

# Opzionale: email per Let's Encrypt se si abilita HTTPS
# LETSENCRYPT_EMAIL=

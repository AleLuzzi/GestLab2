# Profilo vendibile di staging. Stesso schema della produzione, altro
# server, altro database e altro dominio. Non committare la copia compilata.

GESTLAB_HOSTING=managed
GESTLAB_ENV=staging
GESTLAB_SECRET_SOURCE=secrets-manager
GESTLAB_DB_BACKUP=pitr
GESTLAB_PUBLIC_URL=https://staging.example.com

DB_HOST=staging.db.example.com
DB_PORT=3306
DB_NAME=gestlab_staging
DB_USER=gestlab_app
DB_PWD=
DB_POOL_SIZE=10
DB_SSL_CA=/etc/ssl/certs/rds-global-bundle.pem

GESTLAB_PEER_DB_HOST=production.db.example.com
GESTLAB_PEER_DB_NAME=gestlab_production

JWT_SECRET=

GESTLAB_ADMIN_EMAIL=
GESTLAB_ADMIN_PASSWORD=
GESTLAB_TENANT_NOME=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# DSN diverso da quello di produzione, così gli eventi non si mescolano.
SENTRY_DSN=

# Profilo vendibile di produzione. Copiare sul server di produzione e
# sostituire i segreti con i valori letti da AWS Secrets Manager.
# Non committare la copia compilata.
#
# Il database è un'istanza MySQL o MariaDB gestita, distinta da quella di
# staging, con backup automatici e point-in-time recovery. DB_SSL_CA è il
# bundle CA del provider, per esempio il global bundle RDS.

GESTLAB_HOSTING=managed
GESTLAB_ENV=production
GESTLAB_SECRET_SOURCE=secrets-manager
GESTLAB_DB_BACKUP=pitr
GESTLAB_PUBLIC_URL=https://app.example.com

DB_HOST=production.db.example.com
DB_PORT=3306
DB_NAME=gestlab_production
DB_USER=gestlab_app
DB_PWD=
DB_POOL_SIZE=10
DB_SSL_CA=/etc/ssl/certs/rds-global-bundle.pem

GESTLAB_PEER_DB_HOST=staging.db.example.com
GESTLAB_PEER_DB_NAME=gestlab_staging

JWT_SECRET=

GESTLAB_ADMIN_EMAIL=
GESTLAB_ADMIN_PASSWORD=
GESTLAB_TENANT_NOME=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Opzionale. Senza questo valore gli errori restano in logs/gestlab-saas.log.
SENTRY_DSN=

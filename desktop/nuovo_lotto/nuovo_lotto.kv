#:kivy 2.3.1

<RigaLottoIngresso>:
    orientation: 'horizontal'
    padding: dp(8)
    spacing: dp(8)
    md_bg_color: app.theme_cls.primaryContainerColor if self.selected else (0.62, 0.62, 0.62, 1)
    label_1: ''
    label_2: ''
    label_3: ''
    label_4: ''
    MDLabel:
        text: root.label_1
        theme_text_color: 'Custom'
        text_color: (0, 0, 0, 1) if root.selected else (1, 1, 1, 1)
    MDLabel:
        text: root.label_2
        theme_text_color: 'Custom'
        text_color: (0, 0, 0, 1) if root.selected else (1, 1, 1, 1)
    MDLabel:
        text: root.label_3
        theme_text_color: 'Custom'
        text_color: (0, 0, 0, 1) if root.selected else (1, 1, 1, 1)
    MDLabel:
        text: root.label_4
        theme_text_color: 'Custom'
        text_color: (0, 0, 0, 1) if root.selected else (1, 1, 1, 1)

<RigaLottoVendita>:
    orientation: 'horizontal'
    padding: dp(8)
    spacing: dp(8)
    md_bg_color: app.theme_cls.primaryContainerColor if self.selected else (0.62, 0.62, 0.62, 1)
    label_1: ''
    label_2: ''
    label_3: ''
    label_4: ''
    MDLabel:
        text: root.label_1
        theme_text_color: 'Custom'
        text_color: (0, 0, 0, 1) if root.selected else (1, 1, 1, 1)
    MDLabel:
        text: root.label_2
        theme_text_color: 'Custom'
        text_color: (0, 0, 0, 1) if root.selected else (1, 1, 1, 1)
    MDLabel:
        text: root.label_3
        theme_text_color: 'Custom'
        text_color: (0, 0, 0, 1) if root.selected else (1, 1, 1, 1)
    MDLabel:
        text: root.label_4
        theme_text_color: 'Custom'
        text_color: (0, 0, 0, 1) if root.selected else (1, 1, 1, 1)

<Nuovo_lotto>:
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: 'vertical'
        MDTopAppBar:
            type: "small"
            theme_bg_color: "Custom"
            md_bg_color: app.theme_cls.primaryColor
            MDTopAppBarTitle:
                text: 'Nuovo Lotto'
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
        MDBoxLayout:
            orientation: 'vertical'
            padding: dp(12)
            spacing: dp(8)
            MDLabel:
                id: label_progressivo
                text: 'Progressivo vendita'
                bold: True
                size_hint_y: None
                height: dp(32)
            MDBoxLayout:
                orientation: 'horizontal'
                spacing: dp(12)
                MDBoxLayout:
                    orientation: 'vertical'
                    MDLabel:
                        text: 'LOTTI DI INGRESSO APERTI'
                        bold: True
                        size_hint_y: None
                        height: dp(32)
                    MDBoxLayout:
                        size_hint_y: None
                        height: dp(32)
                        MDLabel:
                            text: 'Lotto'
                            bold: True
                        MDLabel:
                            text: 'Data'
                            bold: True
                        MDLabel:
                            text: 'Taglio'
                            bold: True
                        MDLabel:
                            text: 'Residuo'
                            bold: True
                    RecycleView:
                        id: rv_lotti_ingresso
                        viewclass: 'RigaLottoIngresso'
                        SelectableRecycleBoxLayout:
                            default_size: None, dp(42)
                            default_size_hint: 1, None
                            size_hint_y: None
                            height: self.minimum_height
                            orientation: 'vertical'
                            multiselect: False
                MDBoxLayout:
                    orientation: 'vertical'
                    size_hint_x: 0.42
                    spacing: dp(8)
                    MDLabel:
                        id: label_lotto_selezionato
                        text: 'Nessun lotto selezionato'
                        size_hint_y: None
                        height: dp(48)
                    MDTextField:
                        id: campo_prodotto
                        mode: 'outlined'
                        readonly: True
                        MDTextFieldHintText:
                            text: 'Prodotto ottenuto'
                    MDTextField:
                        id: campo_quantita
                        mode: 'outlined'
                        input_filter: 'float'
                        MDTextFieldHintText:
                            text: 'Quantità prodotta (kg)'
                    MDButton:
                        style: 'filled'
                        on_release: root.aggiungi_riga()
                        MDButtonText:
                            text: 'AGGIUNGI RIGA'
            MDLabel:
                id: label_conteggio
                text: 'Righe inserite: 0'
                bold: True
                size_hint_y: None
                height: dp(32)
            MDBoxLayout:
                size_hint_y: None
                height: dp(32)
                MDLabel:
                    text: 'Lotto ingresso'
                    bold: True
                MDLabel:
                    text: 'Prodotto'
                    bold: True
                MDLabel:
                    text: 'Quantità'
                    bold: True
                MDLabel:
                    text: 'Origine'
                    bold: True
            RecycleView:
                id: rv_righe
                viewclass: 'RigaLottoVendita'
                SelectableRecycleBoxLayout:
                    default_size: None, dp(40)
                    default_size_hint: 1, None
                    size_hint_y: None
                    height: self.minimum_height
                    orientation: 'vertical'
                    multiselect: False
            MDLabel:
                id: label_errore
                text: ''
                theme_text_color: 'Custom'
                text_color: 0.8, 0, 0, 1
                size_hint_y: None
                height: dp(28) if self.text else 0
            MDBoxLayout:
                size_hint_y: None
                height: dp(48)
                spacing: dp(8)
                MDButton:
                    style: 'text'
                    on_release: root.rimuovi_riga()
                    MDButtonText:
                        text: 'RIMUOVI RIGA'
                MDButton:
                    style: 'text'
                    on_release: root.esci_senza_salvare()
                    MDButtonIcon:
                        icon: 'arrow-left'
                    MDButtonText:
                        text: 'CHIUDI'
                MDButton:
                    style: 'filled'
                    on_release: root.salva_ed_esci()
                    MDButtonText:
                        text: 'SALVA ED ESCI'
